{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|png|jpg|jpeg|gif|svg|ico|webp)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(html|xml|txt)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/auto-x",
        "destination": "https://autox.network/",
        "type": 301
      },
      {
        "source": "/auto-x/",
        "destination": "https://autox.network/",
        "type": 301
      },
      {
        "source": "/auto-x/**",
        "destination": "https://autox.network/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/api/contentengine-publish",
        "function": "contentenginePublish",
        "region": "us-central1"
      },
      {
        "source": "/sitemap.xml",
        "function": "publishedSitemapXml",
        "region": "us-central1"
      },
      {
        "source": "/robots.txt",
        "function": "publishedRobotsTxt",
        "region": "us-central1"
      },
      {
        "source": "/**",
        "function": "servePublishedPage",
        "region": "us-central1"
      }
    ],
    "cleanUrls": true
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}
